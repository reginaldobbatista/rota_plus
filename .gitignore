**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Artefatos do Gradle. O `/build/` acima só cobre a raiz do projeto.
android/build/
android/.gradle/
android/app/build/
android/local.properties

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# Segredos — nada aqui pode ir para o repositório
# ---------------------------------------------------------------------------

# Arquivos de --dart-define-from-file (chaves do Supabase, DSN do Sentry).
# Ignora o conteúdo real mas mantém o modelo versionado. Ignorar a pasta
# inteira (`env/`) não funcionaria: o git não entra em diretório ignorado
# para aplicar a exceção.
env/*
!env/example.json
!env/README.md
*.env

# Assinatura de release do Android
/android/key.properties
*.jks
*.keystore

# Credenciais de serviço
service-account*.json
google-services.json
GoogleService-Info.plist

# Supabase CLI local
supabase/.branches/
supabase/.temp/
.supabase/

# Preferências locais do Claude Code (podem conter caminhos e permissões)
.claude/settings.local.json

# Capturas de referência: material de trabalho, não código. 123 JPEGs que
# engordariam o repositório sem serem usados em build nem em teste.
docs/imagens/
