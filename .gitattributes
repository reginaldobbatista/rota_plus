# Normaliza fim de linha: LF no repositório, nativo na área de trabalho.
# Sem isso, quem usa Windows e quem usa macOS/Linux geram diff em arquivo
# que ninguém alterou.
* text=auto eol=lf

# Scripts que precisam de LF para executar
*.sh text eol=lf
gradlew text eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binários: nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.jks binary

# Código gerado: colapsa no diff do GitHub, mas continua versionado
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
